# ==========================================
# AI News Aggregator - Environment Variables
# ==========================================

# PostgreSQL Database Configuration (Local Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news_db

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_LOOKBACK_HOURS=24

# Email Digest Notifications (Phase 4)
RECIPIENT_EMAIL=dhruvchugh2007@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# LLM Providers (Phase 3)
OPENAI_API_KEY=
GEMINI_API_KEY=

